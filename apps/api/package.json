{
  "name": "@gpoint/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/core.test.ts test/telegram-init-data.test.ts test/telegram-ingestion.test.ts test/telegram-prepared-button.test.ts test/telegram-channel-rights.test.ts test/telegram-avatar-download.test.ts test/agata-integration.test.ts test/messages.test.ts",
    "test:integration": "NODE_ENV=test node --import tsx --test test/integration.test.ts test/telegram-ingestion.integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.879.0",
    "@aws-sdk/s3-request-presigner": "^3.879.0",
    "@gpoint/contracts": "workspace:*",
    "@gpoint/agata-client": "workspace:*",
    "@nestjs/common": "^11.0.5",
    "@nestjs/core": "^11.0.5",
    "@nestjs/platform-fastify": "^11.0.5",
    "@prisma/client": "^6.2.1",
    "blurhash": "2.0.5",
    "fastify": "^5.2.1",
    "jose": "^6.0.1",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
