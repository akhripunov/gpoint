gpoint.amiora.one {
  encode gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
  request_body {
    max_size 60MB
  }
  @gsales_worker path /gsales/agata-worker/*
  handle @gsales_worker {
    uri strip_prefix /gsales
    reverse_proxy 127.0.0.1:8010
  }
  @eros_worker_embeddings path /api/eros-worker/v1/embeddings*
  respond @eros_worker_embeddings 404
  @api path /api/*
  handle @api {
    reverse_proxy 127.0.0.1:3001
  }
  @media path /media/*
  handle @media {
    rewrite * /api{uri}
    reverse_proxy 127.0.0.1:3001
  }
  @app_entry path / /index.html
  header @app_entry Cache-Control "no-store, max-age=0"
  handle {
    reverse_proxy 127.0.0.1:3003
  }
}
