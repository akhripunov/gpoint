generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  telegramUserId BigInt @unique
  telegramUsername String?
  firstName String?
  lastName String?
  languageCode String?
  isPremium Boolean?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastSeenAt DateTime?
  clicks AffiliateClick[]
  owners CreatorOwner[]
  follows Follow[]
  likes PostLike[]
  events ProductEvent[]
  roles UserRole[]
  discoveryPreferences UserPreference[]
  personalizationResetAt DateTime?
  channelChallenges TelegramConnectionChallenge[]
  channelInstallAttempts CreatorChannelInstallAttempt[]
  codexChatConnections CodexChatConnection[]
  codexDeviceAuthorizations CodexDeviceAuthorization[]
  erosRelationships ErosRelationshipMapping[]
  erosAssistantMessageStates ErosAssistantMessageState[]
  chatConsents GpointChatConsent[]
  ageAssurances GpointAgeAssurance[]
  aiDisclosureReceipts GpointAiDisclosureReceipt[]
}
model UserPreference {
  id String @id @default(cuid())
  userId String
  preferenceType String
  entityType String
  entityId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])
  @@unique([userId, preferenceType, entityType, entityId])
  @@index([userId, preferenceType])
}
model Creator {
  id String @id @default(cuid())
  displayName String
  slug String @unique
  createdAt DateTime @default(now())
  profile CreatorProfile?
  bots CreatorBot[]
  clicks AffiliateClick[]
  owners CreatorOwner[]
  follows Follow[]
  events ProductEvent[]
  vipOffers VipOffer[]
  posts Post[]
  mediaAssets MediaAsset[]
  telegramChannel TelegramChannel?
  codexChatConnections CodexChatConnection[]
  codexDeviceAuthorizations CodexDeviceAuthorization[]
  erosRelationships ErosRelationshipMapping[]
  erosAssistantMessageStates ErosAssistantMessageState[]
}

// Contains only revocable, hashed Codex capability tokens. Conversation data is owned by stock Eros.
model CodexChatConnection {
  id String @id @default(cuid())
  userId String
  creatorId String
  accessTokenHash String @unique
  refreshTokenHash String @unique
  accessExpiresAt DateTime
  refreshExpiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  @@index([userId, creatorId, revokedAt])
  @@index([refreshExpiresAt])
}

model CodexDeviceAuthorization {
  id String @id @default(cuid())
  deviceCodeHash String @unique
  telegramChallengeHash String @unique
  sourceHash String
  expiresAt DateTime
  userId String?
  creatorId String?
  consumedAt DateTime?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator Creator? @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}
model CreatorProfile {
  id String @id @default(cuid())
  creatorId String @unique
  status String @default("DRAFT")
  bio String?
  tagsJson String @default("[]")
  erosGenomeId String? @unique @db.Uuid
  avatarMediaId String?
  coverMediaId String?
  moderationReason String?
  moderatedByUserId String?
  moderatedAt DateTime?
  creator Creator @relation(fields: [creatorId], references: [id])
}

// Maps a GPoint user/persona relationship to the instance created by stock Eros.
// Eros remains the source of truth for relationship state and conversation data.
model ErosRelationshipMapping {
  userId String
  creatorId String
  instanceId String @unique @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Keep the Eros instance pointer until a supported Eros erasure lifecycle exists.
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  @@id([userId, creatorId])
  @@index([creatorId])
}

// Product read state only; conversation bodies remain owned by stock Eros.
model ErosAssistantMessageState {
  userId String
  creatorId String
  sessionId String @db.Uuid
  messageId String @db.VarChar(64)
  readAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  @@id([userId, creatorId, sessionId, messageId])
  @@index([userId, creatorId, sessionId, readAt])
}

// GPoint owns policy and permission state; Eros owns chat bodies and memories.
model GpointChatPolicyProfile {
  id String @id @default(cuid())
  sourceAgataId String? @unique
  sourceTenantId String
  jurisdiction String
  market String
  version Int
  status String
  effectiveFrom DateTime
  effectiveTo DateTime?
  rules Json
  createdAt DateTime @default(now())
  receipts GpointAiDisclosureReceipt[]
  @@unique([sourceTenantId, jurisdiction, market, version])
  @@index([sourceTenantId, jurisdiction, market, status, effectiveFrom])
}

model GpointChatConsent {
  id String @id @default(cuid())
  sourceAgataId String? @unique
  sourceTenantId String
  userId String
  purpose String
  grantedAt DateTime
  revokedAt DateTime?
  policyVersion String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, purpose, grantedAt])
}

model GpointAgeAssurance {
  id String @id @default(cuid())
  sourceAgataId String? @unique
  sourceTenantId String
  userId String
  ageBand String
  status String
  method String
  jurisdiction String
  verifiedAt DateTime?
  assertedAt DateTime?
  expiresAt DateTime?
  version Int
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([userId, jurisdiction, version])
  @@index([userId, version])
}

model GpointAiDisclosureReceipt {
  id String @id @default(cuid())
  sourceAgataId String? @unique
  sourceTenantId String
  userId String
  policyProfileId String
  policyVersion Int
  channel String
  receiptKey String
  displayedAt DateTime
  memoryOptIn Boolean
  memoryOptInAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  policy GpointChatPolicyProfile @relation(fields: [policyProfileId], references: [id], onDelete: Restrict)
  @@index([userId, policyProfileId, policyVersion, displayedAt])
}

// Non-destructive lineage fence for legacy AGATA conversations. Encrypted content is archived below.
model GpointLegacyConversationFence {
  id String @id @default(cuid())
  sourceAgataConversationId String @unique
  sourceTenantId String
  userId String?
  creatorId String?
  sourceUserId String
  sourceCharacterId String
  messageCount Int
  memoryCount Int
  firstMessageAt DateTime?
  lastMessageAt DateTime?
  consentWasActive Boolean
  migratedAt DateTime @default(now())
  @@index([userId, creatorId])
}

// Archived legacy history keeps AGATA's encrypted payload envelope and key version.
// It is not automatically imported into an Eros session or decrypted by the API.
model GpointLegacyConversationArchive {
  id String @id @default(cuid())
  sourceAgataConversationId String @unique
  sourceTenantId String
  userId String?
  creatorId String?
  sourceRelationshipId String
  sourceScope String
  sourceScenarioId String?
  sourceSystem String
  sourceExternalId String?
  startedAt DateTime
  closedAt DateTime?
  languageCode String
  createdAt DateTime @default(now())
  @@index([userId, creatorId, startedAt])
}

model GpointLegacyMessageArchive {
  id String @id @default(cuid())
  sourceAgataMessageId String @unique
  sourceAgataConversationId String
  sourceTenantId String
  userId String?
  creatorId String?
  idempotencyKey String
  role String
  contentCiphertext Bytes?
  contentNonce Bytes?
  contentKeyVersion String?
  systemMessageType String?
  systemAction String?
  occurredAt DateTime
  deletedAt DateTime?
  incomingReadAt DateTime?
  languageCode String
  createdAt DateTime @default(now())
  @@index([sourceAgataConversationId, occurredAt])
  @@index([userId, creatorId, occurredAt])
}

model CreatorOwner {
  id String @id @default(cuid())
  creatorId String
  userId String
  role String @default("OWNER")
  creator Creator @relation(fields: [creatorId], references: [id])
  user User @relation(fields: [userId], references: [id])
  @@unique([creatorId, userId])
}
model CreatorBot {
  id String @id @default(cuid())
  creatorId String
  telegramBotId String @unique
  telegramUsername String
  status String
  miniAppEnabled Boolean @default(false)
  affiliateProgramStatus String @default("UNKNOWN")
  commissionPermille Int?
  durationMonths Int?
  gpointAffiliateUrl String?
  gpointAffiliatePeerId String?
  lastVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creator Creator @relation(fields: [creatorId], references: [id])
  clicks AffiliateClick[]
  affiliateProgram AffiliateProgram?
  affiliateLinks AffiliateLink[]
}
model TelegramChannel {
  id String @id @default(cuid())
  creatorId String @unique
  telegramChatId String @unique
  username String?
  title String?
  avatarMediaId String?
  status String @default("PENDING")
  importMode String @default("AUTO")
  importHashtag String?
  verificationCodeHash String?
  connectedAt DateTime?
  disconnectedAt DateTime?
  lastPostReceivedAt DateTime?
  lastSuccessfulIngestAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creator Creator @relation(fields: [creatorId], references: [id])
  posts Post[]
  @@index([status, updatedAt])
}
model TelegramConnectionChallenge {
  id String @id @default(cuid())
  requestId Int @unique
  userId String
  expiresAt DateTime
  usedAt DateTime?
  telegramChatId String?
  preparedButtonId String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  @@index([userId, expiresAt])
}
model CreatorChannelInstallAttempt {
  id String @id @default(cuid())
  gpointUserId String
  telegramUserId BigInt
  state String @default("WAITING_FOR_TELEGRAM")
  createdAt DateTime @default(now())
  expiresAt DateTime
  completedAt DateTime?
  user User @relation(fields: [gpointUserId], references: [id])
  evidence TelegramChannelInstallEvidence[]
  @@index([telegramUserId, state, expiresAt])
  @@index([gpointUserId, state, expiresAt])
}
model TelegramChannelInstallEvidence {
  id String @id @default(cuid())
  telegramUpdateId Int @unique
  attemptId String?
  telegramChatId String
  chatType String
  chatTitle String?
  actorTelegramUserId BigInt
  oldBotStatus String?
  newBotStatus String
  botRightsSnapshot Json?
  eventDate DateTime?
  receivedAt DateTime @default(now())
  attempt CreatorChannelInstallAttempt? @relation(fields: [attemptId], references: [id])
  @@index([actorTelegramUserId, receivedAt])
  @@index([telegramChatId, receivedAt])
}
model AffiliateProgram {
  id String @id @default(cuid())
  creatorBotId String @unique
  status String
  commissionPermille Int
  durationMonths Int?
  verifiedAt DateTime?
  creatorBot CreatorBot @relation(fields: [creatorBotId], references: [id])
}
model AffiliateLink {
  id String @id @default(cuid())
  creatorBotId String
  url String @unique
  createdAt DateTime @default(now())
  clicks AffiliateClick[]
  creatorBot CreatorBot @relation(fields: [creatorBotId], references: [id])
}
model VipOffer {
  id String @id @default(cuid())
  creatorId String
  title String
  description String?
  priceStars Int?
  billingLabel String?
  affiliateUrl String
  status String @default("DRAFT")
  moderationReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clicks AffiliateClick[]
  creator Creator @relation(fields: [creatorId], references: [id])
}
model AffiliateClick {
  id String @id @default(cuid())
  userId String
  creatorId String
  creatorBotId String
  vipOfferId String?
  affiliateLinkId String?
  placement String
  source String?
  campaign String?
  sessionId String?
  clickedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  creator Creator @relation(fields: [creatorId], references: [id])
  bot CreatorBot @relation(fields: [creatorBotId], references: [id])
  vipOffer VipOffer? @relation(fields: [vipOfferId], references: [id])
  link AffiliateLink? @relation(fields: [affiliateLinkId], references: [id])
  @@index([userId, creatorBotId, clickedAt])
}
model Follow {
  userId String
  creatorId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  creator Creator @relation(fields: [creatorId], references: [id])
  @@id([userId, creatorId])
}
model ProductEvent {
  id String @id @default(cuid())
  userId String?
  creatorId String?
  eventType String
  entityType String?
  entityId String?
  sessionId String?
  metadataJson Json?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id])
  creator Creator? @relation(fields: [creatorId], references: [id])
  @@index([eventType, createdAt])
  @@index([creatorId, eventType, createdAt])
  @@index([userId, entityType, entityId, eventType, createdAt])
}
model UserRole {
  userId String
  role String
  user User @relation(fields: [userId], references: [id])
  @@id([userId, role])
}
model ModerationAction {
  id String @id @default(cuid())
  adminUserId String
  targetType String
  targetId String
  action String
  reason String?
  previousStatus String?
  previousSafetyClassification String?
  createdAt DateTime @default(now())
}
model AttributionEvidence {
  id String @id @default(cuid())
  source String
  observedAt DateTime @default(now())
  externalReference String?
  stars Int?
  commissionPermille Int?
  notes String?
}
model MediaAsset {
  id String @id @default(cuid())
  creatorId String
  kind String
  storageProvider String
  storageKey String
  mimeType String
  fileSize Int
  width Int?
  height Int?
  aspectRatio Float?
  blurHash String?
  safetyProvider String?
  safetyProviderVersion String?
  safetyConfidence Float?
  safetyEvaluatedAt DateTime?
  safetyFailureReason String?
  durationMs Int?
  thumbnailStorageKey String?
  status String @default("UPLOADING")
  createdAt DateTime @default(now())
  postMedia PostMedia[]
  creator Creator @relation(fields: [creatorId], references: [id])
}
model Post {
  id String @id @default(cuid())
  creatorId String
  type String
  isReel Boolean @default(false)
  caption String?
  status String @default("DRAFT")
  moderationReason String?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  source String @default("GPOINT")
  telegramChannelId String?
  telegramMessageId Int?
  telegramMediaGroupId String?
  telegramPublishedAt DateTime?
  telegramEditedAt DateTime?
  sourceText String?
  sourceLanguage String?
  sanitizedText String?
  safetyClassification String @default("UNCERTAIN")
  safetyReason String?
  ingestStatus String?
  media PostMedia[]
  creator Creator @relation(fields: [creatorId], references: [id])
  telegramChannel TelegramChannel? @relation(fields: [telegramChannelId], references: [id])
  translations PostTranslation[]
  likes PostLike[]
  @@unique([telegramChannelId, telegramMessageId])
  @@index([source, ingestStatus])
}
model PostLike {
  id String @id @default(cuid())
  userId String
  postId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])
  @@unique([userId, postId])
  @@index([postId, createdAt])
}
model PostTranslation {
  id String @id @default(cuid())
  postId String
  language String
  text String
  provider String
  sourceHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post Post @relation(fields: [postId], references: [id])
  @@unique([postId, language, sourceHash])
  @@index([postId, language])
}
model PostMedia {
  postId String
  mediaAssetId String
  sortOrder Int
  post Post @relation(fields: [postId], references: [id])
  media MediaAsset @relation(fields: [mediaAssetId], references: [id])
  @@id([postId, mediaAssetId])
}
