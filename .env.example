NODE_ENV=development
DATABASE_URL=
REDIS_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Existing bot @username; required to create Codex Telegram deep links.
TELEGRAM_BOT_USERNAME=
# Production bot→API must use HTTPS; local development may omit this for loopback default.
GPOINT_INGEST_URL=
# Exact GPoint user IDs allowed to authorize local Codex access; fail-closed when empty.
GPOINT_CODEX_OWNER_USER_IDS=
# Exact trusted proxy socket-peer IPs; use "none" only when API is directly exposed.
GPOINT_CODEX_DEVICE_START_TRUSTED_PROXY_IPS=
API_PORT=3000
MINIAPP_ORIGIN=
DEV_AUTH_MODE=false
MAX_IMAGE_MB=10
MAX_VIDEO_MB=100
MAX_VIDEO_DURATION_SEC=60
MEDIA_LOCAL_ROOT=./.local-media

# Optional infrastructure profiles (disabled by default)
IMGPROXY_ENABLED=false
IMGPROXY_URL=http://127.0.0.1:8080
IMGPROXY_SOURCE_BASE_URL=http://127.0.0.1:3000
IMGPROXY_KEY=
IMGPROXY_SALT=
GPOINT_SAFETY_PROVIDER=unconfigured
GPOINT_SAFETY_URL=
GPOINT_SAFETY_API_KEY=
GPOINT_SAFETY_TIMEOUT_MS=60000
SEARCH_ENABLED=false
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_MASTER_KEY=
NOTIFICATIONS_PROVIDER=deferred
NOVU_URL=
NOVU_API_KEY=
