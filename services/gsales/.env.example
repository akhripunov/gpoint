# Disposable test default only. Production requires a provisioned tenant UUID
# distinct from this value and bound to gsales_runtime in agata_identity.
GSALES_TENANT_ID=c4d67889-877e-4d1b-a8d8-597c479d638f
GSALES_DATABASE_URL=
GSALES_OWNER_API_TOKEN=
GSALES_WORKER_TOKEN=
GSALES_OWNER_TELEGRAM_ID=
GSALES_OUTREACH_ENABLED=false
GSALES_AUTO_REPLY_ENABLED=false
GSALES_MANAGEMENT_ENABLED=false
GSALES_AGATA_URL=http://agata-gsales:8000
# Local direct-run client token. The production Compose profile derives this
# from GSALES_AGATA_INTERNAL_API_TOKEN so Core and API use the same lane token.
GSALES_AGATA_API_TOKEN=
# These nine GSALES_AGATA_* values are required only when the gsales
# Compose profile is enabled. Keys must be distinct from GPOINT's keys.
GSALES_AGATA_DATABASE_URL=
GSALES_AGATA_TENANT_ID=
GSALES_AGATA_INTERNAL_API_TOKEN=
GSALES_AGATA_LLM_PROVIDER=
GSALES_AGATA_MESSAGE_AEAD_KEY=
GSALES_AGATA_REQUEST_FINGERPRINT_HMAC_KEY=
GSALES_AGATA_RETRIEVAL_QUERY_HMAC_KEY=
GSALES_AGATA_SHADOW_CANDIDATE_HMAC_KEY=
GSALES_AGATA_RESPONSE_FINGERPRINT_HMAC_KEY=
GSALES_MANAGEMENT_BOT_TOKEN=
GSALES_MANAGEMENT_BOT_ID=
GSALES_MANAGEMENT_WEBHOOK_SECRET=
GSALES_SECRET_DIR=
GSALES_SECRET_MASTER_KEY=
GSALES_GPOINT_URL=
GSALES_GPOINT_API_TOKEN=

GSALES_TELEGRAM_LISTENER_ENABLED=false

GSALES_PRODUCTION_MODE=false
