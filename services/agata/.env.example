# Copy to an untracked .env for local AGATA-only development. Never use these placeholders.
AGATA_DATABASE_URL=postgresql+asyncpg://gpoint:REPLACE_ME@postgres:5432/gpoint
AGATA_TENANT_ID=00000000-0000-4000-8000-000000000001
AGATA_INTERNAL_API_TOKEN=REPLACE_WITH_RANDOM_SERVICE_TOKEN
AGATA_MESSAGE_AEAD_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
AGATA_MESSAGE_AEAD_KEY_VERSION=v1
AGATA_REQUEST_FINGERPRINT_HMAC_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
AGATA_RETRIEVAL_QUERY_HMAC_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
AGATA_RESPONSE_FINGERPRINT_HMAC_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
AGATA_SHADOW_CANDIDATE_HMAC_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
AGATA_EMBEDDING_API_KEY=REPLACE_WITH_PROVIDER_KEY
AGATA_LLM_API_KEY=REPLACE_WITH_PROVIDER_KEY
AGATA_LLM_PROVIDER=anymodel
AGATA_LLM_MODEL=cx/gpt-5.6-terra
AGATA_LLM_API_BASE_URL=https://anymodel.org/v1
AGATA_LLM_TIMEOUT_SECONDS=12
AGATA_DB_POOL_SIZE=5
AGATA_DB_MAX_OVERFLOW=5
AGATA_WORKER_POLL_SECONDS=2
AGATA_WORKER_BATCH_SIZE=4
