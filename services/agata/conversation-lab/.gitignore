# Dataset content is local-only. Keep only synthetic, reviewed fixtures in golden/.
data/raw/*
data/processed/*
data/runs/*
data/golden/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/runs/.gitkeep
!data/golden/.gitkeep
!data/golden/synthetic/
data/golden/synthetic/*
!data/golden/synthetic/.gitkeep
