# Eros Mac Worker config. Keep the real compatibility-path file at
# ~/.config/gpoint/agata-worker.env with mode 600; never commit real values.
GPOINT_EROS_WORKER_URL=https://gpoint.one/api/gpoint-worker
GPOINT_EROS_WORKER_TOKEN=REPLACE_WITH_DEDICATED_RANDOM_WORKER_TOKEN
# Trusted tenant pin for the Eros GPOINT runtime; use its provisioned ID.
GPOINT_EROS_TENANT_ID=REPLACE_WITH_OWNER_VERIFIED_GPOINT_TENANT_UUID

# Optional: empty values use the currently configured Codex CLI defaults.
AGATA_CODEX_MODEL=
AGATA_CODEX_REASONING=
AGATA_CODEX_JOB_TIMEOUT_SECONDS=180
