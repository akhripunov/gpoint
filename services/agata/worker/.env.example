# Local Mac worker config. Keep the real file at
# ~/.config/gpoint/agata-worker.env with mode 600; never commit real values.
GPOINT_AGATA_WORKER_URL=https://gpoint.amiora.one/api/agata-worker
GPOINT_AGATA_WORKER_TOKEN=REPLACE_WITH_DEDICATED_RANDOM_WORKER_TOKEN
# Trusted tenant pin for this specific GPOINT runtime; use its provisioned ID.
GPOINT_AGATA_TENANT_ID=REPLACE_WITH_OWNER_VERIFIED_GPOINT_TENANT_UUID

# Optional: empty values use the currently configured Codex CLI defaults.
AGATA_CODEX_MODEL=
AGATA_CODEX_REASONING=
AGATA_CODEX_JOB_TIMEOUT_SECONDS=180

# Optional second fixed target, serviced serially by the same watch/lock.
# Keep both unset to retain GPOINT-only behavior. Never reuse GPOINT token.
# GSALES_AGATA_WORKER_URL=https://<approved-sales-host>/agata-worker
# GSALES_AGATA_WORKER_TOKEN=<distinct-gsales-worker-secret>
# GSALES_AGATA_TENANT_ID=<owner-approved-gsales-runtime-tenant-uuid>
