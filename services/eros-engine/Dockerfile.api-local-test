FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/api/package.json ./apps/api/package.json
COPY packages ./packages
RUN pnpm install --frozen-lockfile --filter @gpoint/api... --filter @gpoint/db... \
    && pnpm --filter @gpoint/contracts build \
    && pnpm --filter @gpoint/agata-client build \
    && pnpm --filter @gpoint/db exec prisma generate --schema prisma/schema.prisma
COPY apps/api ./apps/api
COPY services/eros-engine/local-test-api-routes.mjs services/eros-engine/local-test-api-routes.mjs
COPY services/eros-engine/local-test-api-entrypoint.mjs services/eros-engine/local-test-api-entrypoint.mjs
COPY services/eros-engine/local-test-e2e.mjs services/eros-engine/local-test-e2e.mjs
ENV NODE_ENV=development
ENTRYPOINT ["node", "services/eros-engine/local-test-api-entrypoint.mjs"]
