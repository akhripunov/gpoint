diff --git a/crates/eros-engine-server/src/main.rs b/crates/eros-engine-server/src/main.rs
index fa7555a..1cbc973 100644
--- a/crates/eros-engine-server/src/main.rs
+++ b/crates/eros-engine-server/src/main.rs
@@ -152,0 +153,24 @@ async fn run_migrations() -> Result<()> {
+    // SQLx creates its unqualified `_sqlx_migrations` table before migration
+    // 0000 runs, so ensure the isolated schema exists before invoking it.
+    sqlx::query("CREATE SCHEMA IF NOT EXISTS engine")
+        .execute(&pool)
+        .await
+        .context("failed to create engine schema for migration ledger")?;
+    let engine_ledger_exists: bool =
+        sqlx::query_scalar("SELECT to_regclass('engine._sqlx_migrations') IS NOT NULL")
+            .fetch_one(&pool)
+            .await
+            .context("failed to inspect Eros migration ledger")?;
+    let engine_objects_exist: bool = sqlx::query_scalar(
+        "SELECT EXISTS (\
+            SELECT 1 FROM pg_class c \
+            JOIN pg_namespace n ON n.oid = c.relnamespace \
+            WHERE n.nspname = 'engine' AND c.relkind IN ('r', 'p') \
+              AND c.relname <> '_sqlx_migrations'\
+        )",
+    )
+    .fetch_one(&pool)
+    .await
+    .context("failed to inspect existing Eros tables")?;
+    validate_migration_ledger_state(engine_ledger_exists, engine_objects_exist)
+        .map_err(anyhow::Error::msg)?;
@@ -179,2 +203,3 @@ async fn run_server() -> Result<()> {
-    let openrouter_key =
-        std::env::var("OPENROUTER_API_KEY").context("OPENROUTER_API_KEY is required")?;
+    // The built-in OpenRouter route checks its key when selected. A custom-only
+    // model config must not require an unrelated OpenRouter credential.
+    let openrouter_key = openrouter_key(std::env::var("OPENROUTER_API_KEY").ok());
@@ -458,0 +484,16 @@ fn resolve_legacy_secret(has_jwks: bool, jwt_secret: Option<String>) -> Result<O
+fn openrouter_key(value: Option<String>) -> String {
+    value.unwrap_or_default()
+}
+
+fn validate_migration_ledger_state(
+    engine_ledger_exists: bool,
+    engine_objects_exist: bool,
+) -> Result<(), String> {
+    if engine_objects_exist && !engine_ledger_exists {
+        return Err(
+            "engine tables exist without engine._sqlx_migrations; refusing to rerun migrations or adopt public history automatically".into(),
+        );
+    }
+    Ok(())
+}
+
