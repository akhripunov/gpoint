+            let mut request = Vec::new();
+            let mut buffer = [0_u8; 4096];
+            let header_end = loop {
+                let count = stream.read(&mut buffer).await.unwrap();
+                assert!(count > 0, "client closed before sending request headers");
+                request.extend_from_slice(&buffer[..count]);
+                if let Some(index) = request.windows(4).position(|window| window == b"\r\n\r\n") {
+                    break index + 4;
+                }
+            };
+            let headers = String::from_utf8_lossy(&request[..header_end]);
+            let content_length = headers
+                .lines()
+                .find_map(|line| {
+                    let (name, value) = line.split_once(':')?;
+                    name.eq_ignore_ascii_case("content-length")
+                        .then(|| value.trim().parse::<usize>().unwrap())
+                })
+                .unwrap_or(0);
+            while request.len() < header_end + content_length {
+                let count = stream.read(&mut buffer).await.unwrap();
+                assert!(count > 0, "client closed before sending request body");
+                request.extend_from_slice(&buffer[..count]);
+            }
+            let _ = request_seen_tx.send(());
+            let _ = release_rx.await;
+            let response = format!(
+                "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}",
+                llm_response.len(),
+                llm_response
+            );
+            stream.write_all(response.as_bytes()).await.unwrap();
+        });
+        let (_embed_server, embed) = embed_router_mock().await;
+
+        let mut state = crate::routes::companion::test_state(pool.clone());
+        state.model_config = std::sync::Arc::new(
+            eros_engine_llm::model_config::ModelConfig::from_toml_str(
+                "[tasks.memory_extraction]\nmodel = \"primary\"\nfilter_prompt = \"extract\"\n",
+            )
+            .unwrap(),
+        );
+        state.openrouter = std::sync::Arc::new(
+            eros_engine_llm::openrouter::OpenRouterClient::with_base_url(
+                "test-key".into(),
+                format!("http://{llm_addr}/api/v1/chat/completions"),
+            ),
+        );
+        state.embed = std::sync::Arc::new(embed);
+
+        let user_id = Uuid::new_v4();
+        let instance_id = seed_persona_instance(&pool, user_id).await;
+        let session_id: Uuid = sqlx::query_scalar(
+            "INSERT INTO engine.chat_sessions (user_id, instance_id) VALUES ($1, $2) RETURNING id",
+        )
+        .bind(user_id)
+        .bind(instance_id)
+        .fetch_one(&pool)
+        .await
+        .unwrap();
+        sqlx::query(
+            "INSERT INTO engine.chat_messages (session_id, role, content) VALUES ($1, 'user', 'synthetic source')",
+        )
+        .bind(session_id)
+        .execute(&pool)
+        .await
+        .unwrap();
+
+        let classify = tokio::spawn(async move {
+            classify_session(&state, session_id, user_id, Some(instance_id)).await
+        });
+        tokio::time::timeout(std::time::Duration::from_secs(5), request_seen_rx)
+            .await
+            .expect("classifier reaches provider barrier")
+            .expect("provider barrier receiver remains connected");
+
+        eros_engine_store::session_archive::SessionArchiveRepo { pool: &pool }
+            .archive_relationship(user_id, instance_id)
+            .await
+            .unwrap();
+        release_tx
+            .send(())
+            .expect("mock provider is waiting to release its response");
+        tokio::time::timeout(std::time::Duration::from_secs(5), classify)
+            .await
+            .expect("classifier completes after provider response is released")
+            .unwrap()
+            .expect("delayed classifier completes");
+
+        let count: i64 =
+            sqlx::query_scalar("SELECT count(*) FROM engine.companion_memories WHERE user_id = $1")
+                .bind(user_id)
