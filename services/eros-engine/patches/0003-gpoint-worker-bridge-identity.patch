--- a/crates/eros-engine-server/src/pipeline/handlers.rs
+++ b/crates/eros-engine-server/src/pipeline/handlers.rs
@@ -20,0 +21,71 @@ use eros_engine_store::memory::MemoryRepo;
+fn gpoint_bridge_model(model: &str) -> bool {
+    model.rsplit_once('@').is_some_and(|(_, provider)| provider == "gpoint")
+}
+
+#[derive(serde::Serialize)]
+struct WorkerBridgeClaims {
+    iss: &'static str,
+    aud: &'static str,
+    sub: String,
+    tenant_id: String,
+    session_id: String,
+    instance_id: String,
+    creator_id: String,
+    jti: String,
+    iat: usize,
+    exp: usize,
+}
+
+fn sign_worker_bridge_identity(
+    user_id: Uuid,
+    session_id: Uuid,
+    instance_id: Uuid,
+    creator_id: Uuid,
+    user_message_id: Uuid,
+) -> Result<String, AppError> {
+    let secret = std::env::var("GPOINT_WORKER_BRIDGE_SIGNING_SECRET")
+        .map_err(|_| AppError::Internal("worker bridge identity is not configured".into()))?;
+    if secret.len() < 32 {
+        return Err(AppError::Internal("worker bridge identity is not configured".into()));
+    }
+    let tenant_id = std::env::var("GPOINT_WORKER_TENANT_ID")
+        .map_err(|_| AppError::Internal("worker bridge identity is not configured".into()))?;
+    let tenant_id = Uuid::parse_str(&tenant_id)
+        .map_err(|_| AppError::Internal("worker bridge identity is not configured".into()))?;
+    let now = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_err(|_| AppError::Internal("worker bridge clock is invalid".into()))?
+        .as_secs() as usize;
+    sign_worker_bridge_identity_with(secret.as_bytes(), tenant_id, user_id, session_id, instance_id, creator_id, user_message_id, now)
+}
+
+fn sign_worker_bridge_identity_with(
+    secret: &[u8],
+    tenant_id: Uuid,
+    user_id: Uuid,
+    session_id: Uuid,
+    instance_id: Uuid,
+    creator_id: Uuid,
+    user_message_id: Uuid,
+    now: usize,
+) -> Result<String, AppError> {
+    let claims = WorkerBridgeClaims {
+        iss: "eros-engine",
+        aud: "gpoint-worker-gateway",
+        sub: user_id.to_string(),
+        tenant_id: tenant_id.to_string(),
+        session_id: session_id.to_string(),
+        instance_id: instance_id.to_string(),
+        creator_id: creator_id.to_string(),
+        jti: user_message_id.to_string(),
+        iat: now,
+        exp: now + 60,
+    };
+    jsonwebtoken::encode(
+        &jsonwebtoken::Header::new(jsonwebtoken::Algorithm::HS256),
+        &claims,
+        &jsonwebtoken::EncodingKey::from_secret(secret),
+    )
+    .map_err(|_| AppError::Internal("worker bridge identity could not be signed".into()))
+}
+
