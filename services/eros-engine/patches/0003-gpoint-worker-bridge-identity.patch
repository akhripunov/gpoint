@@ -1166,0 +1256,38 @@ mod tests {
+    #[test]
+    fn gpoint_bridge_identity_is_signed_from_trusted_server_ids_and_expires_quickly() {
+        use jsonwebtoken::{decode, DecodingKey, Validation};
+        let user = Uuid::new_v4();
+        let session = Uuid::new_v4();
+        let instance = Uuid::new_v4();
+        let creator = Uuid::new_v4();
+        let message = Uuid::new_v4();
+        let tenant = Uuid::new_v4();
+        let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs() as usize;
+        let secret = b"local-eros-bridge-signing-secret-32-bytes-minimum";
+        let token = sign_worker_bridge_identity_with(secret, tenant, user, session, instance, creator, message, now)
+            .expect("identity signs");
+        let mut validation = Validation::new(jsonwebtoken::Algorithm::HS256);
+        validation.set_issuer(&["eros-engine"]);
+        validation.set_audience(&["gpoint-worker-gateway"]);
+        validation.set_required_spec_claims(&["exp", "iat", "iss", "aud", "sub", "jti"]);
+        let claims = decode::<serde_json::Value>(
+            &token,
+            &DecodingKey::from_secret(secret),
+            &validation,
+        ).expect("signature and standard claims validate").claims;
+        assert_eq!(claims["sub"], user.to_string());
+        assert_eq!(claims["tenant_id"], tenant.to_string());
+        assert_eq!(claims["session_id"], session.to_string());
+        assert_eq!(claims["instance_id"], instance.to_string());
+        assert_eq!(claims["creator_id"], creator.to_string());
+        assert_eq!(claims["jti"], message.to_string());
+        assert_eq!(claims["exp"].as_u64(), Some((now + 60) as u64));
+    }
