#!/bin/sh
set -eu

service="${GPOINT_KAMAL_SERVICE:?GPOINT_KAMAL_SERVICE is required}"
version="${KAMAL_VERSION:?KAMAL_VERSION is required}"
candidate="${GPOINT_COMMIT_SHA:?GPOINT_COMMIT_SHA is required}"
app_source_sha="${GPOINT_APP_SOURCE_SHA:?GPOINT_APP_SOURCE_SHA is required}"
expected_digest="${GPOINT_KAMAL_EXPECTED_DIGEST:?GPOINT_KAMAL_EXPECTED_DIGEST is required}"
hosts="${KAMAL_HOSTS:?KAMAL_HOSTS is required}"
ssh_key="${GPOINT_SSH_KEY:?GPOINT_SSH_KEY is required}"
known_hosts="${GPOINT_KNOWN_HOSTS_FILE:?GPOINT_KNOWN_HOSTS_FILE is required}"

printf '%s\n' "$candidate" | grep -Eq '^[0-9a-f]{40}$'
printf '%s\n' "$app_source_sha" | grep -Eq '^[0-9a-f]{40}$'
case "$version" in "$candidate"-*) ;; *) echo 'Kamal version is not bound to the candidate SHA' >&2; exit 1 ;; esac
printf '%s\n' "$version" | grep -Eq '^[0-9a-f]{40}-[0-9]+-[0-9]+$'
printf '%s\n' "$expected_digest" | grep -Eq '^sha256:[0-9a-f]{64}$'
test -r "$ssh_key" && test -r "$known_hosts"
case "$hosts" in ''|,*|*,|*,,*) echo 'KAMAL_HOSTS is empty or malformed' >&2; exit 1 ;; esac
case "$hosts" in *[!A-Za-z0-9.,-]*) echo 'KAMAL_HOSTS contains an invalid host character' >&2; exit 1 ;; esac
set -f

case "$service" in
  gpoint-core) repository=ghcr.io/akhripunov/gpoint-runtime; expected_revision="$app_source_sha" ;;
  gpoint-agata) repository=ghcr.io/akhripunov/gpoint-agata-runtime; expected_revision="$app_source_sha" ;;
  gpoint-miniapp) repository=ghcr.io/akhripunov/gpoint-miniapp; expected_revision="$app_source_sha" ;;
  gpoint-eros-pilot) repository=ghcr.io/akhripunov/gpoint-eros-pilot; expected_revision=d1a140083321687212fb7b17c09cc0c3c9639f5e ;;
  gpoint-eros-relay) repository=ghcr.io/akhripunov/gpoint-runtime; expected_revision="$app_source_sha" ;;
  *) echo 'Unrecognized GPoint Kamal service' >&2; exit 1 ;;
esac

for host in $(printf '%s' "$hosts" | tr ',' ' '); do
  printf '%s\n' "$host" | grep -Eq '^[A-Za-z0-9.-]+$'
  ssh -F /dev/null -T -i "$ssh_key" \
    -o BatchMode=yes \
    -o IdentitiesOnly=yes \
    -o StrictHostKeyChecking=yes \
    -o UserKnownHostsFile="$known_hosts" \
    "root@$host" bash -s -- "$service" "$repository" "$version" "$candidate" "$app_source_sha" "$expected_revision" "$expected_digest" <<'REMOTE'
set -euo pipefail
service="$1"; repository="$2"; version="$3"; candidate="$4"; app_source_sha="$5"; expected_revision="$6"; expected_digest="$7"
image="$repository:$version"
[[ "$version" == "$candidate-"* && "$version" =~ ^[0-9a-f]{40}-[0-9]+-[0-9]+$ ]]
[[ "$expected_digest" =~ ^sha256:[0-9a-f]{64}$ ]]
[[ "$app_source_sha" =~ ^[0-9a-f]{40}$ && "$expected_revision" =~ ^[0-9a-f]{40}$ ]]
repo_digests="$(docker image inspect --format '{{json .RepoDigests}}' "$image")"
source_sha="$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$image")"
platform="$(docker image inspect --format '{{.Os}}/{{.Architecture}}' "$image")"
EXPECTED_REF="$repository@$expected_digest" python3 - "$repo_digests" <<'PY'
import json, os, sys
try:
    refs = json.loads(sys.argv[1]) or []
except (TypeError, json.JSONDecodeError):
    raise SystemExit('Pulled Kamal image has invalid repository digest metadata')
if os.environ['EXPECTED_REF'] not in refs:
    raise SystemExit('Pulled Kamal image does not match the BuildKit-verified OCI digest')
PY
test "$source_sha" = "$expected_revision"
if [[ "$service" == gpoint-eros-pilot ]]; then
  integration_sha="$(docker image inspect --format '{{index .Config.Labels "com.gpoint.integration.revision"}}' "$image")"
  test "$integration_sha" = "$candidate"
  test "$(docker image inspect --format '{{index .Config.Labels "com.gpoint.eros.patch-set.sha256"}}' "$image")" = none
fi
test "$platform" = linux/amd64
REMOTE
done
