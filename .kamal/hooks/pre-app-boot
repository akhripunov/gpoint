#!/bin/sh
set -eu

service="${GPOINT_KAMAL_SERVICE:?GPOINT_KAMAL_SERVICE is required}"
version="${KAMAL_VERSION:?KAMAL_VERSION is required}"
candidate="${GPOINT_COMMIT_SHA:?GPOINT_COMMIT_SHA is required}"
app_source_sha="${GPOINT_APP_SOURCE_SHA:?GPOINT_APP_SOURCE_SHA is required}"
operation="${GPOINT_KAMAL_OPERATION:-candidate}"
expected_source_sha="${GPOINT_KAMAL_EXPECTED_SOURCE_SHA:-$app_source_sha}"
expected_version="${GPOINT_KAMAL_EXPECTED_VERSION:-$version}"
expected_digest="${GPOINT_KAMAL_EXPECTED_DIGEST:?GPOINT_KAMAL_EXPECTED_DIGEST is required}"
hosts="${KAMAL_HOSTS:?KAMAL_HOSTS is required}"
ssh_key="${GPOINT_SSH_KEY:?GPOINT_SSH_KEY is required}"
known_hosts="${GPOINT_KNOWN_HOSTS_FILE:?GPOINT_KNOWN_HOSTS_FILE is required}"
target_host="${GPOINT_KAMAL_TARGET_HOST:-${GPOINT_PRODUCTION_HOST:-${hosts%%,*}}}"
case ",$hosts," in *,"$target_host",*) ;; *) echo 'Kamal target host is outside the rendered host set' >&2; exit 1 ;; esac

printf '%s\n' "$candidate" | grep -Eq '^[0-9a-f]{40}$'
printf '%s\n' "$app_source_sha" | grep -Eq '^[0-9a-f]{40}$'
printf '%s\n' "$version" | grep -Eq '^[0-9a-f]{40}-[0-9]+-[0-9]+$'
printf '%s\n' "$expected_source_sha" | grep -Eq '^[0-9a-f]{40}$'
test "$version" = "$expected_version" || { echo 'Kamal version differs from the verified component version' >&2; exit 1; }
test "$app_source_sha" = "$expected_source_sha" || { echo 'Kamal component source SHA differs from the verified source SHA' >&2; exit 1; }
case "$operation" in
  candidate)
    test "$app_source_sha" = "$candidate" || { echo 'Core/app source SHA is not bound to the release candidate' >&2; exit 1; }
    case "$version" in "$candidate"-*) ;; *) echo 'Kamal version is not bound to the release candidate' >&2; exit 1 ;; esac
    ;;
  retained)
    test "$service" = gpoint-eros-pilot || { echo 'Retained-image operation is permitted only for the Eros engine' >&2; exit 1; }
    case "$version" in "$expected_source_sha"-*) ;; *) echo 'Retained Eros version is not bound to its verified source SHA' >&2; exit 1 ;; esac
    ;;
  rollback)
    case "$version" in "$expected_source_sha"-*) ;; *) echo 'Rollback image version is not bound to its verified source SHA' >&2; exit 1 ;; esac
    ;;
  *) echo 'Unknown Kamal component operation' >&2; exit 1 ;;
esac
printf '%s\n' "$expected_digest" | grep -Eq '^sha256:[0-9a-f]{64}$'
test -r "$ssh_key" && test -r "$known_hosts"
case "$hosts" in ''|,*|*,|*,,*) echo 'KAMAL_HOSTS is empty or malformed' >&2; exit 1 ;; esac
case "$hosts" in *[!A-Za-z0-9.,-]*) echo 'KAMAL_HOSTS contains an invalid host character' >&2; exit 1 ;; esac
set -f

case "$service" in
  gpoint-core) repository=ghcr.io/akhripunov/gpoint-runtime ;;
  gpoint-agata) repository=ghcr.io/akhripunov/gpoint-agata-runtime ;;
  gpoint-miniapp) repository=ghcr.io/akhripunov/gpoint-miniapp ;;
  gpoint-eros-pilot) repository=ghcr.io/akhripunov/gpoint-eros ;;
  gpoint-eros-relay) repository=ghcr.io/akhripunov/gpoint-runtime ;;
  *) echo 'Unrecognized GPoint Kamal service' >&2; exit 1 ;;
esac

for host in $(printf '%s' "$hosts" | tr ',' ' '); do
  printf '%s\n' "$host" | grep -Eq '^[A-Za-z0-9.-]+$'
  ssh -F /dev/null -T -i "$ssh_key" \
    -o BatchMode=yes \
    -o IdentitiesOnly=yes \
    -o StrictHostKeyChecking=yes \
    -o UserKnownHostsFile="$known_hosts" \
    "root@$host" bash -s -- "$repository" "$version" "$candidate" "$app_source_sha" "$expected_digest" "$operation" "$expected_source_sha" <<'REMOTE'
set -euo pipefail
repository="$1"; version="$2"; candidate="$3"; app_source_sha="$4"; expected_digest="$5"; operation="$6"; expected_source_sha="$7"
image="$repository:$version"
[[ "$version" =~ ^[0-9a-f]{40}-[0-9]+-[0-9]+$ && "$expected_source_sha" =~ ^[0-9a-f]{40}$ ]]
[[ "$version" == "$expected_source_sha-"* && "$app_source_sha" == "$expected_source_sha" ]]
if [[ "$operation" == candidate ]]; then [[ "$version" == "$candidate-"* && "$app_source_sha" == "$candidate" ]]; fi
if [[ "$operation" == retained ]]; then [[ "$repository" == ghcr.io/akhripunov/gpoint-eros ]]; fi
[[ "$expected_digest" =~ ^sha256:[0-9a-f]{64}$ ]]
[[ "$app_source_sha" =~ ^[0-9a-f]{40}$ ]]
repo_digests="$(docker image inspect --format '{{json .RepoDigests}}' "$image")"
if [[ "$repository" == ghcr.io/akhripunov/gpoint-eros ]]; then
  source_sha="$(docker image inspect --format '{{index .Config.Labels "com.gpoint.source.revision"}}' "$image")"
else
  source_sha="$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$image")"
fi
platform="$(docker image inspect --format '{{.Os}}/{{.Architecture}}' "$image")"
EXPECTED_REF="$repository@$expected_digest" python3 - "$repo_digests" <<'PY'
import json, os, sys
try:
    refs = json.loads(sys.argv[1]) or []
except (TypeError, json.JSONDecodeError):
    raise SystemExit('Pulled Kamal image has invalid repository digest metadata')
if os.environ['EXPECTED_REF'] not in refs:
    raise SystemExit('Pulled Kamal image does not match the BuildKit-verified OCI digest')
PY
test "$source_sha" = "$app_source_sha"
test "$platform" = linux/amd64
REMOTE
done
