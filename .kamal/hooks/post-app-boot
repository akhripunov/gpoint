#!/bin/sh
set -eu

service="${GPOINT_KAMAL_SERVICE:?GPOINT_KAMAL_SERVICE is required}"
version="${KAMAL_VERSION:?KAMAL_VERSION is required}"
candidate="${GPOINT_COMMIT_SHA:?GPOINT_COMMIT_SHA is required}"
app_source_sha="${GPOINT_APP_SOURCE_SHA:?GPOINT_APP_SOURCE_SHA is required}"
hosts="${KAMAL_HOSTS:?KAMAL_HOSTS is required}"
roles="${KAMAL_ROLES:-}"
ssh_key="${GPOINT_SSH_KEY:?GPOINT_SSH_KEY is required}"
known_hosts="${GPOINT_KNOWN_HOSTS_FILE:?GPOINT_KNOWN_HOSTS_FILE is required}"

printf '%s\n' "$candidate" | grep -Eq '^[0-9a-f]{40}$'
printf '%s\n' "$app_source_sha" | grep -Eq '^[0-9a-f]{40}$'
case "$version" in "$candidate"-*) ;; *) echo 'Kamal version is not bound to the candidate SHA' >&2; exit 1 ;; esac
printf '%s\n' "$version" | grep -Eq '^[0-9a-f]{40}-[0-9]+-[0-9]+$'
test -r "$ssh_key" && test -r "$known_hosts"
case "$hosts" in ''|,*|*,|*,,*) echo 'KAMAL_HOSTS is empty or malformed' >&2; exit 1 ;; esac
case "$hosts" in *[!A-Za-z0-9.,-]*) echo 'KAMAL_HOSTS contains an invalid host character' >&2; exit 1 ;; esac
set -f

case "$service" in
  gpoint-core)
    default_roles='api,worker,bot'
    ;;
  gpoint-agata)
    default_roles='api,memory-worker'
    ;;
  gpoint-miniapp)
    default_roles='web'
    ;;
  *)
    echo 'Unrecognized GPoint Kamal service' >&2
    exit 1
    ;;
esac

roles="${roles:-$default_roles}"
case "$roles" in ''|,*|*,|*,,*) echo 'KAMAL_ROLES is empty or malformed' >&2; exit 1 ;; esac
case "$roles" in *[!A-Za-z0-9,_-]*) echo 'KAMAL_ROLES contains an invalid role character' >&2; exit 1 ;; esac

for role in $(printf '%s' "$roles" | tr ',' ' '); do
  case "$service:$role" in
    gpoint-core:api) networks='gpoint_app:api,shared_internal:' ;;
    gpoint-core:worker|gpoint-core:bot) networks='gpoint_app:,shared_internal:' ;;
    gpoint-agata:api) networks='gpoint_app:agata-api,shared_internal:agata-api' ;;
    gpoint-agata:memory-worker) networks='gpoint_app:,shared_internal:' ;;
    gpoint-miniapp:web) networks='gpoint_app:' ;;
    *)
      echo 'Unrecognized GPoint Kamal role' >&2
      exit 1
      ;;
  esac

  for host in $(printf '%s' "$hosts" | tr ',' ' '); do
    printf '%s\n' "$host" | grep -Eq '^[A-Za-z0-9.-]+$'
    ssh -T -i "$ssh_key" \
      -o BatchMode=yes \
      -o IdentitiesOnly=yes \
      -o StrictHostKeyChecking=yes \
      -o UserKnownHostsFile="$known_hosts" \
      "root@$host" bash -s -- "$service" "$role" "$version" "$networks" "$candidate" "$app_source_sha" <<'REMOTE'
set -euo pipefail
service="$1"; role="$2"; version="$3"; networks="$4"; candidate="$5"; app_source_sha="$6"
container="${service}-${role}-${version}"
[[ "$container" =~ ^[A-Za-z0-9._-]+$ && "$candidate" =~ ^[0-9a-f]{40}$ && "$app_source_sha" =~ ^[0-9a-f]{40}$ ]]
[[ "$version" == "$candidate-"* && "$version" =~ ^[0-9a-f]{40}-[0-9]+-[0-9]+$ ]]
id="$(docker inspect --format '{{.Id}}' "$container")"
test "$(docker inspect --format '{{.State.Running}}' "$id")" = true
test "$(docker inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$id")" = "$app_source_sha"

IFS=',' read -r -a network_entries <<< "$networks"
for entry in "${network_entries[@]}"; do
  network="${entry%%:*}"
  alias="${entry#*:}"
  docker network inspect "$network" >/dev/null
  network_state="$(docker inspect --format '{{json .NetworkSettings.Networks}}' "$id")"
  if python3 - "$network_state" "$network" "$alias" <<'PY'
import json, sys
networks = json.loads(sys.argv[1]) or {}
network, alias = sys.argv[2:]
if network not in networks:
    raise SystemExit(1)
aliases = networks[network].get("Aliases") or []
raise SystemExit(0 if not alias or alias in aliases else 2)
PY
  then
    continue
  else
    status=$?
    test "$status" -eq 1 || { echo "Existing network alias differs: $network/$alias" >&2; exit 1; }
  fi

  if [[ -n "$alias" ]]; then
    while IFS= read -r other_id; do
      [[ -n "$other_id" && "$other_id" != "$id" ]] || continue
      other_state="$(docker inspect --format '{{json .NetworkSettings.Networks}}' "$other_id")"
      if python3 - "$other_state" "$network" "$alias" <<'PY'
import json, sys
networks = json.loads(sys.argv[1]) or {}
network, alias = sys.argv[2:]
raise SystemExit(0 if alias in ((networks.get(network) or {}).get("Aliases") or []) else 1)
PY
      then
        echo "Network alias is already owned by another container: $network/$alias" >&2
        exit 1
      fi
    done < <(docker network inspect --format '{{range $id, $container := .Containers}}{{println $id}}{{end}}' "$network")
    docker network connect --alias "$alias" "$network" "$id"
  else
    docker network connect "$network" "$id"
  fi
done

if [[ "$service:$role" == "gpoint-agata:memory-worker" ]]; then
  healthy=0
  for attempt in {1..24}; do
    if docker exec "$id" python -m app.memory.worker --healthcheck >/dev/null 2>&1; then
      healthy=1
      break
    fi
    sleep 5
  done
  test "$healthy" -eq 1 || { echo 'AGATA memory worker did not become healthy after network attachment' >&2; exit 1; }
fi
  if [[ "$service:$role" == "gpoint-miniapp:web" ]]; then
    docker exec "$id" nginx -t >/dev/null
  fi
REMOTE

  if [ "$service:$role" = "gpoint-miniapp:web" ]; then
    if [ "${GPOINT_KAMAL_ROOT_ROUTE_BOOTSTRAP:-false}" = true ]; then
      echo 'GPOINT_MINIAPP_API_NETWORK=DEFERRED_FOR_FIRST_CUTOVER'
      continue
    fi
    ssh -T -i "$ssh_key" \
      -o BatchMode=yes \
      -o IdentitiesOnly=yes \
      -o StrictHostKeyChecking=yes \
      -o UserKnownHostsFile="$known_hosts" \
      "root@$host" bash -s -- "$service" "$role" "$version" "$candidate" "$app_source_sha" <<'REMOTE_MINIAPP'
set -euo pipefail
service="$1"; role="$2"; version="$3"; candidate="$4"; app_source_sha="$5"
container="${service}-${role}-${version}"
api_container="gpoint-core-api-${version}"
[[ "$container" =~ ^[A-Za-z0-9._-]+$ && "$candidate" =~ ^[0-9a-f]{40}$ && "$app_source_sha" =~ ^[0-9a-f]{40}$ ]]
id="$(docker inspect --format '{{.Id}}' "$container")"
test "$(docker inspect --format '{{.State.Running}}' "$api_container")" = true
test "$(docker inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$api_container")" = "$app_source_sha"
api_ip="$(docker inspect --format '{{with index .NetworkSettings.Networks "gpoint_app"}}{{.IPAddress}}{{end}}' "$api_container")"
test -n "$api_ip"
resolved_ip="$(docker exec "$id" sh -ec 'getent hosts api' | awk 'NR == 1 {print $1}')"
test "$resolved_ip" = "$api_ip"
echo 'GPOINT_MINIAPP_API_NETWORK=PASS'
REMOTE_MINIAPP
  fi
  done
done
