{
  "name": "gpoint",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @gpoint/api test:integration && node --test tests/integration/*.test.js",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r typecheck",
    "repo:clean:start": "node scripts/repo-clean-gate.mjs start",
    "repo:clean:end": "node scripts/repo-clean-gate.mjs end",
    "release:gpoint": "node scripts/release-gpoint.mjs",
    "release:gpoint:status": "node scripts/release-gpoint.mjs status",
    "test:release": "node --test scripts/release-readiness.test.mjs scripts/release-gpoint.test.mjs scripts/release-gsales.test.mjs scripts/release-bundle.test.mjs scripts/release-bookkeeping.test.mjs scripts/release-authorization.test.mjs scripts/release-runner-readiness.test.mjs scripts/worker-runtime-guard.test.mjs",
    "db:migrate": "pnpm --filter @gpoint/db exec prisma migrate dev",
    "db:seed": "pnpm --filter @gpoint/db exec tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^5.7.2"
  }
}
