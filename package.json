{
  "name": "gpoint",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @gpoint/api test:integration && node --test tests/integration/*.test.js",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r typecheck",
    "repo:clean:start": "node scripts/repo-clean-gate.mjs start",
    "repo:clean:end": "node scripts/repo-clean-gate.mjs end",
    "test:release": "node --test scripts/eros-pilot-deployment.test.mjs scripts/gpoint-vps-runner.test.mjs",
    "db:migrate": "pnpm --filter @gpoint/db exec prisma migrate dev",
    "db:seed": "pnpm --filter @gpoint/db exec tsx prisma/seed.ts",
    "prepush": "python3 scripts/prepush.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@3": "3.1.9",
      "fast-uri@4": "4.2.3",
      "source-map-js": "1.2.2",
      "fastify@5": "5.12.7"
    }
  }
}
