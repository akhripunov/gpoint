{
  "name": "gpoint",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @gpoint/api test:integration && node --test tests/integration/*.test.js",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @gpoint/db exec prisma migrate dev",
    "db:seed": "pnpm --filter @gpoint/db exec tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^5.7.2"
  }
}
